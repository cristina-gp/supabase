generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Producto {
  id     Int    @id @default(autoincrement())
  nombre String
  tipo   String
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String
}